# PostgreSQL connection string (Neon serverless recommended).
# For this prototype use Neon's *direct* (non-pooled) URL so `prisma migrate deploy`
# works during the Vercel build. The pooled URL (host contains "-pooler") also works
# for runtime queries if you hit connection limits.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"
